# ============================================================
# SECRETS & ENVIRONMENT
# ============================================================
# These may contain passwords, API keys, or connection strings
appsettings.Development.json
appsettings.Production.json
.env
.env.local
.env.*.local

# ============================================================
# .NET / ASP.NET CORE (Backend)
# ============================================================
# Build output — generated automatically, no need to track
bin/
obj/

# Visual Studio / Rider project files
.vs/
.idea/
*.user
*.suo

# NuGet packages — restored automatically via dotnet restore
packages/
*.nupkg

# EF Core migrations snapshot backup (keep actual Migrations/ folder)
# (leave this commented unless you have a reason to exclude migrations)
# Migrations/

# ============================================================
# NODE / VITE / REACT (Frontend)
# ============================================================
# Installed packages — restored via npm install
node_modules/

# Build output — generated by npm run build
dist/
dist-ssr/

# Vite cache
.vite/

# TypeScript build info cache
*.tsbuildinfo

# ============================================================
# UPLOADED FILES
# ============================================================
# Portrait images uploaded at runtime — not source code
backend/HouseRiant/HouseRiant/wwwroot/images/portraits/

# ============================================================
# OS / EDITOR JUNK
# ============================================================
.DS_Store          # macOS folder metadata
Thumbs.db          # Windows folder thumbnails
*.swp              # Vim swap files
.vscode/           # VS Code workspace settings (optional — see note)